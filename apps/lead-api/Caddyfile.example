# Caddy als Reverse-Proxy mit automatischem HTTPS (Let's Encrypt).
# Voraussetzung: DNS-A-Record der Subdomain zeigt auf den VPS.
#
# Install (Ubuntu/Debian): https://caddyserver.com/docs/install
# Diese Datei nach /etc/caddy/Caddyfile mergen, dann: systemctl reload caddy

roi-api.newedgebrand.com {
	reverse_proxy 127.0.0.1:8090
}
